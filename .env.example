PORT=18800
DATA_DIR=./data
LOG_LEVEL=debug
LOG_DIR=./data/logs
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Agent Bridge(跨 Agent 通信)
BRIDGE_CALLBACK_TOKEN=
BRIDGE_SERVER_URL=http://localhost:18801

# Agent Hub 机器标识(跨机器 Agent 通信时展示用,如"公司Mac"/"家里PC"/"腾讯云")
# 不配置时回退到 machineId 末 4 位
AGENT_HUB_MACHINE_LABEL=

# Agent Hub 协议规范文档 url(消息提示末尾附给 Agent,Agent 自行下载阅读)
AGENT_HUB_PROTOCOL_DOC_URL=http://106.53.210.241:19000/hub/v1/files/file_fbacdb1333f5/download
